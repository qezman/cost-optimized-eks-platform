# Lookup the latest Ubuntu AMI for the Jenkins EC2 host.
# this keeps the image current while avoiding a hard-coded AMI ID

data "aws_ami" "ubuntu" {
  most_recent = true

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }

  owners = ["099720109477"] # Official Canonical Owner ID
}
